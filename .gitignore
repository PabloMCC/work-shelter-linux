# Dependencias y compilados
node_modules/
dist/
*.tsbuildinfo

# Assets descargados (CC0, se bajan con el arranque); los de terceros que no se pueden bajar de un commit fijo van en el repo
/assets/*
!/assets/terceros/

# Estado local del refugio y datos de usuario
/.data/
.env
.env.*
*.pem
*.key
secrets*

# Capturas temporales de QA
/_capturas/
/capturas/tmp/

# Sistema
.DS_Store

# lo que descarga ./shelter (Node portátil si no hay uno, su pnpm) y el almacén y la caché de pnpm (pnpm-workspace.yaml)
/.runtime/

# Skills de agentes instaladas con autoskills: contenido de terceros con licencias variadas, no se redistribuye.
# skills-lock.json (versionado) fija cuáles y con qué huella; se regeneran con:
#   npx autoskills@0.4.1 -y -a claude-code
#   rm -r .agents/skills/seo .claude/skills/seo && git checkout skills-lock.json
# (la de seo se quita porque no aplica a una app de escritorio; el lock versionado ya no la incluye)
/.agents/
/.claude/skills/
