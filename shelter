#!/bin/bash
# work-shelter — arranque en un solo comando: ./shelter
# Instala lo necesario la primera vez (dependencias, material CC0, compilación) y abre el juego en su ventana.
# Lo único que se asume del sistema es Claude Code instalado y con sesión iniciada.
# SHELTER_DESDE_APP=1 (lo usa /Applications/work-shelter-public.app): prepara y arranca el servidor, escribe la URL en
# una línea «SHELTER_URL=…» y se queda esperando al servidor; la ventana la pone la propia app.
# SHELTER_DESDE_MENU=1 (lo usa el acceso en el menú de Linux, scripts/instalar-app-linux.mjs): un arranque normal, pero
# sin terminal, así que su salida va a shelter.log en la carpeta de los registros.
set -euo pipefail
cd "$(dirname "$0")"
RAIZ="$(pwd)"
source scripts/plataforma.sh
# desde el menú, la salida se añade a shelter.log; solo se empieza uno nuevo si este arranque abre el servidor (paso 6)
if [ -n "${SHELTER_DESDE_MENU:-}" ]; then registro_desde_menu || true; fi
NODO_VERSION="24.22.0"
# el Node mínimo es el de NODO_VERSION (scripts/plataforma.sh, nodo_minimo): el del sistema vale si llega a él
NODO_MINIMO="$(nodo_minimo "$NODO_VERSION")" || { printf 'NODO_VERSION no es una versión x.y.z: «%s»\n' "$NODO_VERSION" >&2; exit 1; }
if [ -n "${SHELTER_DESDE_MENU:-}" ]; then   # al registro, sin colores
  amarillo() { printf '%s\n' "$*"; }; verde() { printf '%s\n' "$*"; }; rojo() { printf '%s\n' "$*" >&2; }
else
  amarillo() { printf '\033[33m%s\033[0m\n' "$*"; }
  verde() { printf '\033[32m%s\033[0m\n' "$*"; }
  rojo() { printf '\033[31m%s\033[0m\n' "$*" >&2; }
fi

# Subórdenes (salir a la superficie, server/superficie.ts): ./shelter superficie [--lista] · ./shelter enganchar <id>
# ./shelter instalar-app [--sin-dock] […]: prepara lo mismo que el arranque y crea la app de macOS o, en Linux, el acceso
# en el menú de aplicaciones, sin abrir el juego. ./shelter desinstalar-app quita el de Linux (solo necesita Node)
# ./shelter doctor: comprueba lo obligatorio y lo opcional (scripts/doctor.sh) sin preparar ni instalar nada
INSTALAR_APP=""; DESINSTALAR_APP=""
case "${1:-}" in doctor) exec bash scripts/doctor.sh ;; superficie|enganchar) SUBORDEN=1 ;; instalar-app) SUBORDEN=""; INSTALAR_APP=1; shift; echo "== work-shelter ==" ;; desinstalar-app) SUBORDEN=""; DESINSTALAR_APP=1; shift ;; *) SUBORDEN=""; echo "== work-shelter ==" ;; esac
# en un sistema sin instalador (o, para desinstalar, fuera de Linux) se avisa antes de preparar nada
if [ -n "$INSTALAR_APP" ]; then instalar_app_disponible || exit 1; fi
if [ -n "$DESINSTALAR_APP" ]; then desinstalar_app_disponible || exit 1; fi

# Carpeta del Node portátil (relativa a la raíz): carpeta_nodo <so> <arq>. Es también el nombre de su descarga
carpeta_nodo() { echo ".runtime/node-v$NODO_VERSION-$1-$2"; }
# Usa el Node de una carpeta del portátil: deja NODE y NPM apuntando a él y su bin/ al principio del PATH
usar_nodo_portatil() { export PATH="$RAIZ/$1/bin:$PATH"; NODE="$RAIZ/$1/bin/node"; NPM="$RAIZ/$1/bin/npm"; }
# El Node que ya hay: el del sistema si llega a NODO_MINIMO, o el portátil ya descargado en .runtime/. No descarga nada;
# solo cambia NODE, NPM y el PATH
nodo_disponible() {
  if command -v node >/dev/null 2>&1 && [ "$(node -p 'process.versions.node.split(".")[0]')" -ge "$NODO_MINIMO" ]; then
    NODE="$(command -v node)"; NPM="$(command -v npm)"; return 0
  fi
  local so arq dir; so="$(so_node 2>/dev/null)" || return 1; arq="$(arq_node "$NODO_VERSION" 2>/dev/null)" || return 1
  dir="$(carpeta_nodo "$so" "$arq")"
  [ -x "$dir/bin/node" ] || return 1
  usar_nodo_portatil "$dir"
}

# superficie y enganchar no preparan nada (solo usan lo ya instalado): no esperan al cerrojo del lanzador ni descargan Node
if [ -n "$SUBORDEN" ]; then
  nodo_disponible && [ -d node_modules/tsx ] || { rojo "work-shelter aún no está instalado: ejecuta ./shelter una vez."; exit 1; }
  exec "$NODE" --import tsx server/superficie.ts "$@"
fi

PUERTO="${SHELTER_PUERTO:-3778}"
DATOS="${SHELTER_DATOS:-$RAIZ/.data}"
# Un solo arranque preparando a la vez (scripts/plataforma.sh, tomar_cerrojo): otro que llegue espera a que este tenga el
# servidor en marcha (se suelta en cuanto contesta, antes de cada exec y, si algo falla antes, al salir) y sigue por el
# camino de «ya abierto», que trae al frente la ventana. Si la espera se agota sin conseguirlo, no se prepara nada
# (ya_abierto_sin_cerrojo): con un servidor que contesta, trae al frente la ventana abierta y sale con 0; sin él, avisa
# de que el otro arranque sigue preparándolo y sale con 1
trap 'soltar_cerrojo' EXIT
if ! tomar_cerrojo "$RAIZ/.runtime/lanzador.lock"; then ya_abierto_sin_cerrojo "$RAIZ" "$PUERTO" "$DATOS" && exit 0; exit 1; fi

# 1. Node NODO_MINIMO o superior (si no hay, se descarga uno portátil en .runtime/, sin permisos de administrador)
if ! nodo_disponible; then
  SO="$(so_node)"; ARQ="$(arq_node "$NODO_VERSION")"; SUMA="$(suma_node "$NODO_VERSION" "$SO" "$ARQ")"
  DIR="$(carpeta_nodo "$SO" "$ARQ")"
  amarillo "No encuentro Node $NODO_MINIMO o superior. Descargo uno portátil para work-shelter (solo esta vez)…"
  mkdir -p .runtime
  curl -fL --progress-bar "https://nodejs.org/dist/v$NODO_VERSION/${DIR#.runtime/}.tar.gz" -o .runtime/node.tar.gz || { rojo "No he podido descargar Node. Comprueba la conexión o instala Node $NODO_MINIMO desde https://nodejs.org"; exit 1; }
  # suma SHA-256 oficial (https://nodejs.org/dist/v$NODO_VERSION/SHASUMS256.txt, en suma_node): no se ejecuta nada que no cuadre
  echo "$SUMA  .runtime/node.tar.gz" | sha256_comprobar >/dev/null || { rm -f .runtime/node.tar.gz; rojo "El Node descargado no cuadra con su suma oficial: no lo uso. Instala Node $NODO_MINIMO desde https://nodejs.org"; exit 1; }
  # si la extracción falla (disco lleno, descarga cortada) no se sigue: lo que quede a medias podría tener ya bin/node
  # y el siguiente arranque lo daría por bueno
  tar -xzf .runtime/node.tar.gz -C .runtime || { rm -rf "$DIR" .runtime/node.tar.gz; rojo "No he podido descomprimir el Node descargado (¿falta espacio en el disco?). Vuelve a ejecutar ./shelter o instala Node $NODO_MINIMO desde https://nodejs.org"; exit 1; }
  rm .runtime/node.tar.gz
  usar_nodo_portatil "$DIR"
  # con el nuevo ya en su sitio, fuera los portátiles anteriores: una actualización deja el viejo y Electron añade al
  # PATH el bin/ de cada uno
  [ -x "$DIR/bin/node" ] && borrar_nodos_viejos "$RAIZ" "$DIR" "$SO" "$ARQ" || true
fi

if [ -n "$DESINSTALAR_APP" ]; then soltar_cerrojo; exec "$NODE" scripts/instalar-app-linux.mjs --desinstalar; fi

# 2. Claude Code (necesario para que los habitantes trabajen)
if ! command -v claude >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/claude" ]; then
  rojo "AVISO: no encuentro Claude Code (el comando 'claude')."
  rojo "  Instálalo (https://docs.claude.com/claude-code) y entra con tu cuenta: abre una terminal, ejecuta 'claude' y luego '/login'."
  rojo "  work-shelter se abrirá igualmente, pero los habitantes no podrán trabajar hasta entonces."
fi

# 3. Dependencias (la primera vez, o si cambia package-lock.json)
SELLO="node_modules/.sello-shelter"
HUELLA="$(huella_de package-lock.json)"
if [ ! -f "$SELLO" ] || [ "$(cat "$SELLO")" != "$HUELLA" ]; then
  amarillo "Instalando dependencias (la primera vez tarda un par de minutos)…"
  "$NPM" ci --no-audit --no-fund --loglevel=error || { rojo "Falló la instalación de dependencias (npm ci)."; exit 1; }
  echo "$HUELLA" > "$SELLO"
fi

# 3b. Binario de Electron (la ventana del juego): este paquete lo descarga aparte. Su ruta la da el propio paquete
# (Electron.app/Contents/MacOS/Electron en macOS, dist/electron en Linux); vacía si aún no está descargado
ELECTRON="$(electron_binario "$NODE")"
if [ -z "$ELECTRON" ] || [ ! -x "$ELECTRON" ]; then
  amarillo "Descargando la ventana del juego (Electron, solo la primera vez)…"
  "$NODE" node_modules/electron/install.js || amarillo "No se pudo descargar Electron: work-shelter se abrirá en el navegador."
  ELECTRON="$(electron_binario "$NODE")"
fi

# 4. Material artístico CC0 (fijado por commit)
if [ ! -f assets/indice.json ]; then
  amarillo "Descargando el material artístico (CC0, unos 70 MB, solo la primera vez)…"
  "$NODE" scripts/descargar-assets.mjs assets && "$NODE" scripts/descargar-extra.mjs assets && "$NODE" scripts/indexar-assets.mjs >/dev/null || { rojo "No se pudo descargar el material. Comprueba la conexión y vuelve a ejecutar ./shelter"; exit 1; }
fi

# 4b. Los personajes de KayKit del probador de Chapa y Pintura: si faltan (una descarga a medias), se baja lo que falte
# aunque el resto ya estuviera
if [ ! -f "assets/kaykit/character-animations-1.1/Mannequin Character/characters/Mannequin_Medium.glb" ]; then
  amarillo "Descargando los personajes que faltan (CC0, unos 30 MB, solo una vez)…"
  "$NODE" scripts/descargar-extra.mjs assets && "$NODE" scripts/indexar-assets.mjs >/dev/null || amarillo "No se pudieron bajar los personajes: se reintentará en el próximo arranque."
fi

# 5. Compilar la interfaz si no existe o su código ha cambiado desde la última compilación (por contenido, no por fechas)
if ! "$NODE" -e "process.exit(require('./scripts/huellas.cjs').clienteAlDia() ? 0 : 1)"; then
  amarillo "Compilando work-shelter…"
  "$NODE" scripts/huellas.cjs compilar || { rojo "Falló la compilación de la interfaz."; exit 1; }
fi

if [ -n "$INSTALAR_APP" ]; then
  amarillo "Creando la app…"
  soltar_cerrojo; exec "$NODE" "$(instalador_app)" "$@"
fi

# 6. Servidor local (solo 127.0.0.1, bajo un supervisor que lo relanza al pulsar «Reiniciar» en el juego) y ventana
# un servidor de antes de los últimos cambios que siga en marcha se pone al día (o se aparta) sin cerrar sus terminales
if curl -fs "http://127.0.0.1:$PUERTO/salud" >/dev/null 2>&1; then
  "$NODE" scripts/huellas.cjs poner-al-dia "$PUERTO" "$DATOS" >/dev/null || amarillo "No he podido poner al día el refugio que ya estaba abierto."
fi
if curl -fs "http://127.0.0.1:$PUERTO/salud" >/dev/null 2>&1; then
  amarillo "Ya hay un work-shelter abierto en el puerto $PUERTO: traigo su ventana al frente."
  SERVIDOR_PID=""
else
  # este arranque será el dueño del servidor: desde el menú, su salida (y la del servidor) va a un shelter.log nuevo
  if [ -n "${SHELTER_DESDE_MENU:-}" ]; then registro_desde_menu nuevo || true; fi
  amarillo "Abriendo el refugio…"
  if [ -n "${SHELTER_SIN_VENTANA:-}" ]; then "$NODE" server/supervisor.mjs &
  else SHELTER_SALIR_SIN_CLIENTES=1 "$NODE" server/supervisor.mjs & fi
  SERVIDOR_PID=$!
  trap 'soltar_cerrojo; [ -n "$SERVIDOR_PID" ] && kill -INT $SERVIDOR_PID 2>/dev/null; wait $SERVIDOR_PID 2>/dev/null' EXIT INT TERM
  for i in $(seq 1 60); do curl -fs "http://127.0.0.1:$PUERTO/salud" >/dev/null 2>&1 && break; sleep 0.25; done
fi
# el secreto de este arranque (lo escribe el servidor, solo legible por ti) va en el fragmento de la URL
for i in $(seq 1 40); do [ -s "$DATOS/token" ] && break; sleep 0.1; done
URL="http://127.0.0.1:$PUERTO/#t=$(cat "$DATOS/token" 2>/dev/null)"
soltar_cerrojo   # el servidor ya contesta: otro arranque puede seguir (y encontrará este abierto)
if [ -n "${SHELTER_DESDE_APP:-}" ]; then
  # la app lee esta línea y abre la ventana; el servidor se apaga solo cuando se cierra. Su código de salida llega a
  # la app: 76 es «reiniciar con la app entera» (han cambiado archivos que solo se leen al abrirla)
  echo "SHELTER_URL=$URL"
  CODIGO=0
  [ -n "$SERVIDOR_PID" ] && { wait $SERVIDOR_PID || CODIGO=$?; }
  trap - EXIT INT TERM   # el servidor ya no está: que la trampa no cambie el código de salida
  exit $CODIGO
fi
# Ctrl+C solo lo cierra todo si este arranque es el dueño del servidor; si no, esta ventana solo trae la que ya había
if [ -n "$SERVIDOR_PID" ]; then verde "work-shelter en marcha: http://127.0.0.1:$PUERTO  (Ctrl+C aquí lo cierra todo)"
else verde "work-shelter en marcha: http://127.0.0.1:$PUERTO"; fi
if [ -n "${SHELTER_SIN_VENTANA:-}" ]; then
  # pruebas y uso sin ventana: el servidor queda en marcha hasta Ctrl+C
  echo "Abre: $URL"
  [ -n "$SERVIDOR_PID" ] && wait $SERVIDOR_PID
elif [ -n "$ELECTRON" ] && [ -x "$ELECTRON" ]; then
  # su salida, al registro (solo legible por ti, el de la última vez); si cae nada más abrir, el navegador. Si no se
  # puede crear la carpeta del registro, sin registro (vacío): su salida se queda en esta terminal
  # se vacía solo si este arranque es el dueño; si no, es el registro de la ventana que ya está abierta y se añade
  LOG="$(carpeta_registros)/electron.log"
  if [ -n "$SERVIDOR_PID" ]; then ( umask 077; mkdir -p "${LOG%/*}" && : > "$LOG" ) 2>/dev/null || LOG=
  else ( umask 077; mkdir -p "${LOG%/*}" && : >> "$LOG" ) 2>/dev/null || LOG=; fi
  if ! SHELTER_URL="$URL" SHELTER_CDP="${SHELTER_CDP:-}" SHELTER_DEV="${SHELTER_DEV:-}" ventana_electron "$ELECTRON" "$LOG" electron/main.cjs; then
    amarillo "Abro work-shelter en el navegador."
    abrir_url "$URL"
    [ -n "$SERVIDOR_PID" ] && wait $SERVIDOR_PID
  fi
else
  amarillo "No encuentro Electron; abro work-shelter en el navegador."
  abrir_url "$URL"
  [ -n "$SERVIDOR_PID" ] && wait $SERVIDOR_PID
fi
