{
  "name": "work-shelter",
  "version": "0.1.0",
  "private": true,
  "description": "work-shelter: refugio subterráneo jugable que es la interfaz de trabajo sobre Claude Code",
  "desktopName": "work-shelter-public.desktop",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "server": "tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:prune": "oxlint --prune-suppressions"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "three": "0.182.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "node-gyp": "13.1.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "^1.64.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
